10 REM SPECCY JAMS - a tiny tune
20 BORDER 0: PAPER 0: INK 7: BRIGHT 0: FLASH 0
30 GO SUB 8000
40 GO SUB 7000: GO SUB 6000
50 GO TO 5000
1000 REM play pitch p for d secs in colour q
1010 LET o=INT (p/12): LET n=p-12*o: LET v=t(n+1)
1020 PRINT AT 2,12; INK q;"note: ";n$(2*n+1 TO 2*n+2)
1030 IF v<0 THEN GO TO 1100
1040 LET k=v+7*o: LET a=23042+2*k
1050 PRINT AT 15,u;" ": LET u=2*k+2: PRINT AT 15,u; INK q;CHR$ 144
1060 FOR j=0 TO 160 STEP 32: POKE a+j,64+8*q: POKE a+j+1,64+8*q: NEXT j
1070 BORDER q: BEEP d,p
1080 FOR j=0 TO 160 STEP 32: POKE a+j,56: POKE a+j+1,56: NEXT j
1090 RETURN
1100 LET k=-v-1+7*o: LET a=23043+2*k
1110 PRINT AT 15,u;" ": LET u=2*k+3: PRINT AT 15,u; INK q;CHR$ 144
1120 FOR j=0 TO 96 STEP 32: POKE a+j,56+q: POKE a+j+1,56+q: NEXT j
1130 BORDER q: BEEP d,p
1140 FOR j=0 TO 96 STEP 32: POKE a+j,56: POKE a+j+1,56: NEXT j
1150 RETURN
5000 REM free play
5010 PRINT AT 1,0; INK 5;"AWSEDFTGYHUJK=notes P=tune Q=end"
5020 LET i$=INKEY$: IF i$="" THEN GO TO 5020
5030 IF CODE i$>96 THEN LET i$=CHR$ (CODE i$-32)
5040 IF i$="Q" THEN PRINT AT 1,0; INK 6;"   thanks for listening! :)     ": STOP
5050 IF i$="P" THEN GO SUB 7000: GO SUB 6000: GO TO 5000
5060 FOR m=1 TO 13: IF k$(m)=i$ THEN LET p=m-1: LET d=.15: LET q=2+p-4*INT (p/4): GO SUB 1000
5070 NEXT m
5080 GO TO 5020
6000 REM play the tune, drawing a piano roll
6010 RESTORE 9000: LET x=8
6020 READ p,d: IF p=99 THEN RETURN
6030 LET q=2+p-4*INT (p/4): LET y=64+4*p: LET l=INT (d*14+.5)
6040 IF x+l<255 THEN PLOT INK q;x,y: DRAW INK q;l-2,0: PLOT INK q;x,y+1: DRAW INK q;l-2,0: PLOT INK q;x,y+2: DRAW INK q;l-2,0
6050 LET x=x+l: GO SUB 1000: GO TO 6020
7000 REM draw the screen
7010 BORDER 0: CLS
7020 PRINT AT 0,0; INK 6; BRIGHT 1;"   *** S P E C C Y  J A M S *** "
7030 PRINT AT 1,0; INK 5;"   a tiny tune by Claude, 2026  "
7040 FOR r=16 TO 21: PRINT AT r,2; PAPER 7; INK 0;"                            ": NEXT r
7050 INK 0: PAPER 7
7060 PLOT 16,0: DRAW 223,0: DRAW 0,47: DRAW -223,0: DRAW 0,-47
7070 FOR i=1 TO 13: PLOT 16+16*i,0: DRAW 0,47: NEXT i
7080 FOR i=0 TO 12: LET n=i-7*INT (i/7): IF n=2 OR n=6 THEN GO TO 7110
7090 LET b=32+16*i
7100 FOR j=-4 TO 3: PLOT b+j,20: DRAW 0,27: NEXT j
7110 NEXT i
7120 INK 7: PAPER 0: LET u=2
7130 RETURN
8000 REM note graphic, key tables
8010 RESTORE 8100
8020 FOR i=0 TO 7: READ b: POKE USR "a"+i,b: NEXT i
8030 DIM t(12): FOR i=1 TO 12: READ t(i): NEXT i
8040 LET n$="C C#D D#E F F#G G#A A#B ": LET k$="AWSEDFTGYHUJK": LET u=2
8050 RETURN
8100 DATA 24,28,22,18,16,112,240,96
8110 DATA 0,-1,1,-2,2,3,-4,4,-5,5,-6,6
9000 REM the tune: pitch (semitones from middle C), seconds
9010 DATA 4,.25,7,.25,12,.5,11,.25,9,.25,7,.5,5,.25,9,.25,14,.25,12,.25,11,.5,7,.5
9020 DATA 4,.25,7,.25,12,.5,14,.25,16,.25,17,.5,16,.25,14,.25,12,.25,11,.25,12,1
9030 DATA 9,.25,12,.25,16,.5,14,.25,12,.25,11,.5,7,.25,11,.25,14,.25,17,.25,16,.5,12,.5
9040 DATA 9,.25,12,.25,16,.5,19,.25,17,.25,16,.5,14,.25,11,.25,7,.25,11,.25,12,1
9050 DATA 0,.08,4,.08,7,.08,12,.08,16,.08,19,.08,12,.6
9060 DATA 99,0
